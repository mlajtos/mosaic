{
  "name": "mosaic-browser",
  "productName": "Mosaic",
  "version": "0.0.3",
  "license": "MIT",
  "description": "Web browser that can display multiple web pages at the same time in one shared window.",
  "author": {
    "name": "Milan Lajtoš",
    "email": "milan.lajtos@me.com",
    "url": "https://github.com/mlajtos"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mlajtos/mosaic.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "compile": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "build": "electron-builder -wlm",
    "dist": "yarn compile && yarn build"
  },
  "build": {
    "appId": "com.github.mlajtos.mosaic",
    "buildVersion": "1",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "publish": "github",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "category": "Network",
      "icon": "build/icon.png",
      "synopsis": "Web browser that can display multiple web pages at the same time in one shared window.",
      "executableName": "mosaic",
      "target": [
        "deb",
        "rpm",
        "pacman",
        "tar.gz"
      ]
    }
  },
  "dependencies": {
    "electron-window-state": "^5.0.3"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.28",
    "@fortawesome/free-solid-svg-icons": "^5.13.0",
    "@fortawesome/react-fontawesome": "^0.1.10",
    "@react-hook/merged-ref": "^1.1.1",
    "@types/is-url": "^1.2.32",
    "@types/jquery": "^3",
    "@types/node": "^24.0.0",
    "@types/react": "^16.14.0",
    "@types/react-dom": "^16.9.8",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "golden-layout": "1.5.9",
    "is-url": "^1.2.4",
    "jquery": "^3.7.1",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "recoil": "0.0.8",
    "sass": "^1.105.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
