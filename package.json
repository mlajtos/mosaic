{
  "name": "mosaic-browser",
  "productName": "Mosaic",
  "version": "0.0.3",
  "license": "MIT",
  "description": "Web browser that can display multiple web pages at the same time in one shared window.",
  "author": {
    "name": "Milan Lajtoš",
    "email": "milan.lajtos@me.com",
    "url": "https://github.com/mlajtos"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mlajtos/mosaic.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "compile": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "build": "electron-builder -wlm",
    "dist": "yarn compile && yarn build"
  },
  "build": {
    "appId": "com.github.mlajtos.mosaic",
    "buildVersion": "1",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "licenses/Trellis-LICENSE-NONCOMMERCIAL.md",
        "to": "licenses/Trellis-LICENSE-NONCOMMERCIAL.md"
      }
    ],
    "publish": "github",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "category": "Network",
      "icon": "build/icon.png",
      "synopsis": "Web browser that can display multiple web pages at the same time in one shared window.",
      "executableName": "mosaic",
      "target": [
        "deb",
        "rpm",
        "pacman",
        "tar.gz"
      ]
    }
  },
  "dependencies": {
    "electron-window-state": "^5.0.3"
  },
  "devDependencies": {
    "@danfessler/trellis": "^0.1.0",
    "@danfessler/trellis-react": "^0.1.0",
    "@types/is-url": "^1.2.32",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "is-url": "^1.2.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
